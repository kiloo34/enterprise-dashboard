# =============================================================================
# Enterprise Dashboard — Environment Variables
# =============================================================================
# COPY file ini menjadi .env dan isi dengan nilai yang sesuai.
# File .env TIDAK boleh di-commit ke git (sudah ada di .gitignore).
# =============================================================================

# ─── WAJIB DIISI ──────────────────────────────────────────────────────────────

# JWT Secret Key — harus kuat dan unik per environment.
# Generate dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Gemini AI API Key (opsional — untuk fitur AI di Recon service)
GEMINI_API_KEY=

# ─── DATABASE ─────────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=changeme_in_production

# ─── OBJECT STORAGE (MinIO) ───────────────────────────────────────────────────

MINIO_ROOT_PASSWORD=changeme_in_production
MINIO_SECRET_KEY=changeme_in_production

# ─── CORS — Origins yang diizinkan ───────────────────────────────────────────
# Pisahkan beberapa origin dengan koma. Contoh production:
# ALLOWED_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost

# ─── COOKIE SECURITY ─────────────────────────────────────────────────────────
# Set ke false HANYA di local dev (HTTP). Harus true di staging/production (HTTPS).
COOKIE_SECURE=false

# ─── GRAFANA ─────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_PASSWORD=changeme_in_production
