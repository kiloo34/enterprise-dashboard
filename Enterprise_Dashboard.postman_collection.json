{
  "info": {
    "name": "Enterprise Dashboard API",
    "description": "Koleksi API Endpoint lengkap untuk pengembangan Frontend Enterprise Dashboard v2. Mendukung autentikasi Bearer Token, manajemen peran (RBAC), monitoring transaksi QRIS, dan sistem Import Data rekonsiliasi yang berjalan di belakang Traefik Proxy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "description": "Endpoint Autentikasi dan Manajemen Sesi",
      "item": [
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@enterprise.local\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/auth/refresh",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "User Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/auth/logout",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Users & Settings",
      "description": "Endpoint Informasi Profil dan Pengaturan UI",
      "item": [
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/users",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "users"]
            }
          }
        },
        {
          "name": "Update UI Settings (Sidebar State)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ui_settings\": {\n    \"sidebar_collapsed\": true\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/users/settings",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "users", "settings"]
            }
          }
        }
      ]
    },
