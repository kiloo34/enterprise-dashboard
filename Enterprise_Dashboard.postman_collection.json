    {
      "name": "5. Engine & Data Import",
      "item": [
        {
          "name": "Upload CSV/TXT Data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "/path/to/sample.csv"
                },
                {
                  "key": "target_table",
                  "value": "app.engine_sts_proses_rpt_his",
                  "type": "text"
                },
                {
                  "key": "priority",
                  "value": "5",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/api/recon/imports/upload",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "recon", "imports", "upload"]
            }
          }
        },
        {
          "name": "Get Live Import History Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/recon/imports",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "recon", "imports"]
            }
          }
        },
        {
          "name": "Get Engine Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/engine/monitor/stats",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "engine", "monitor", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Dashboard Data Analytics",
      "item": [
        {
          "name": "Get Financial Metrics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/dashboard/financial?category=KREDIT",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "dashboard", "financial"],
              "query": [
                {
                  "key": "category",
                  "value": "KREDIT"
                }
              ]
            }
          }
        },
        {
          "name": "Get QRIS Analysis (AI)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/dashboard/qris-analysis?date=2026-01-02",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "dashboard", "qris-analysis"],
              "query": [
                {
                  "key": "date",
                  "value": "2026-01-02"
                }
              ]
            }
          }
        },
        {
          "name": "Get QRIS AJ Summary Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/recon/dashboard/qris-stats",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "recon", "dashboard", "qris-stats"]
            }
          }
        },
        {
          "name": "Get Rintis Summary Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/recon/dashboard/rintis-stats",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "recon", "dashboard", "rintis-stats"]
            }
          }
        },
        {
          "name": "Get Txs Lists (QRIS)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/recon/dashboard/qris-transactions?limit=100",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "recon", "dashboard", "qris-transactions"],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost",
      "type": "string"
    },
    {
      "key": "ACCESS_TOKEN",
      "value": "your_jwt_token_here",
      "type": "string"
    }
  ]
}
